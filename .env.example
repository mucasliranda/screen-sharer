# ---- LiveKit ----
# Cloud:      wss://<seu-projeto>.livekit.cloud
# Self-host:  ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Chaves. Para self-host local, os valores abaixo batem com o livekit.yaml.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-de-desenvolvimento-com-32-chars-min

# Segredo para assinar o hostKey (HMAC). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROOM_SECRET=troque-isto-em-producao

# ---- Supabase (controle de uso) ----
# Sem estas duas, o app funciona normalmente e apenas nao registra uso.
# A service_role ignora RLS: NUNCA prefixe com NEXT_PUBLIC_ e nunca use no cliente.
# Dashboard > Project Settings > API Keys > service_role
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Transporte de mídia ----
# livekit (padrão) — SFU, upload constante, consome cota do LiveKit.
# p2p            — malha direta entre navegadores, sem custo de banda de
#                  servidor, mas o upload de quem transmite vira N × 1,5 Mbps.
# Valor inválido não cai em silêncio: a sala não abre e mostra o erro.
TRANSPORT=p2p

# ---- Sinalização do modo p2p ----
# Chave PUBLICÁVEL do Supabase (sb_publishable_... ou a anon legada).
# Não é segredo — é entregue ao navegador para abrir o canal de Realtime.
# Só é necessária quando TRANSPORT=p2p.
SUPABASE_PUBLISHABLE_KEY=
