# ---- LiveKit ----
# Cloud:      wss://<seu-projeto>.livekit.cloud
# Self-host:  ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Chaves. Para self-host local, os valores abaixo batem com o livekit.yaml.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret-de-desenvolvimento-com-32-chars-min

# Segredo para assinar o hostKey (HMAC). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROOM_SECRET=troque-isto-em-producao
